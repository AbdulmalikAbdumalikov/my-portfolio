# Never commit .env or paste these secrets into frontend source files.
TELEGRAM_BOT_TOKEN=replace_with_the_new_token_from_botfather
TELEGRAM_OWNER_CHAT_ID=replace_with_your_private_chat_id
# Set this after sending /chatid inside the Telegram audit group.
TELEGRAM_AUDIT_CHAT_ID=replace_with_the_signed_group_chat_id
TELEGRAM_TOPIC_USERS_ID=replace_with_users_topic_id
TELEGRAM_TOPIC_COMMANDS_ID=replace_with_commands_topic_id
TELEGRAM_TOPIC_USER_CONTACT_ID=replace_with_user_contact_topic_id
TELEGRAM_TOPIC_QUESTIONS_ID=replace_with_questions_topic_id
# Required to remember users and their verified contacts without duplicates.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
TELEGRAM_TEAM_CHAT_ID=-1004323111381
MODERATION_WORDS=comma,separated,additional,blocked,words
# Create a long random string. It verifies that webhook requests are from Telegram.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret
PORTFOLIO_TELEGRAM_USERNAME=Abdulmalik_Abdumalikov
